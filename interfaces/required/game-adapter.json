{
  "id": "game",
  "type": "ae/game-adapter",
  "version": "1.0.0",
  "notes": "The 14 methods createRoomClass calls on the GameAdapter. Types are in implementation/server/adapter.ts. Provided by turn-engine (interfaces/game-adapter.json lists the same methods).",
  "types": {
    "Result<T>": "{ok:true,value:T}|{ok:false,error:{code:string,message:string,status:400|409|422}}",
    "Deps": "{now:()=>number,rng:()=>number,newId:()=>string}",
    "Actor": "{id:string,role:player|spectator|display}",
    "Presence": "{type:request-seen,id}|{type:live-members,ids}|{type:away,id}|{type:last-connection-close,id,deliberate}"
  },
  "operations": {
    "create": {
      "arguments": [
        "now:number"
      ],
      "returns": "S"
    },
    "restore": {
      "arguments": [
        "saved:unknown",
        "schema:number"
      ],
      "returns": "S; throws on an unsupported schema"
    },
    "options": {
      "arguments": [
        "input:unknown"
      ],
      "returns": "Result<O>"
    },
    "members": {
      "arguments": [
        "state:S"
      ],
      "returns": "{id:string,name:string}[]"
    },
    "summary": {
      "arguments": [
        "state:S"
      ],
      "returns": "{status:string,playerCount:integer,names:string[]}"
    },
    "clearSpectators": {
      "arguments": [
        "state:S"
      ],
      "returns": "boolean"
    },
    "join": {
      "arguments": [
        "state:S",
        "id:string",
        "name:string",
        "rejoining:boolean",
        "deps:Deps"
      ],
      "returns": "Result<{state:S,role:player|spectator}>"
    },
    "parseAction": {
      "arguments": [
        "input:unknown"
      ],
      "returns": "Result<{action:A,requiresVersion:boolean,leaves:boolean}>"
    },
    "apply": {
      "arguments": [
        "state:S",
        "actor:Actor",
        "action:A",
        "deps:Deps"
      ],
      "returns": "Result<S>"
    },
    "presence": {
      "arguments": [
        "state:S",
        "event:Presence",
        "deps:Deps"
      ],
      "returns": "{state:S,changed:boolean}"
    },
    "connection": {
      "arguments": [
        "state:S",
        "actor:Actor",
        "message:unknown",
        "options:O",
        "deps:Deps"
      ],
      "returns": "Result<{state:S,options:O,changed:boolean}>"
    },
    "advance": {
      "arguments": [
        "state:S",
        "deps:Deps"
      ],
      "returns": "{state:S,changed:boolean}"
    },
    "nextWake": {
      "arguments": [
        "state:S"
      ],
      "returns": "number|null"
    },
    "view": {
      "arguments": [
        "state:S",
        "actor:Actor|null",
        "options:O",
        "context:{version:number,roomId:string}"
      ],
      "returns": "V"
    }
  }
}
