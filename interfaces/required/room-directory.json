{
  "id": "room-directory",
  "type": "ae/room-directory",
  "version": "1.0.0",
  "notes": "Not a port of this component. Rooms and the worker call env.DIRECTORY (named \"home\") with these requests; the application binds DIRECTORY to the Directory class from the room-directory component. Listed so the call shape is checkable.",
  "operations": {
    "POST https://directory/": {
      "arguments": [
        "body:RoomInfo (JSON)",
        "x-code-version header"
      ],
      "returns": "204"
    },
    "GET https://directory/": {
      "arguments": [
        "x-code-version header"
      ],
      "returns": "RoomInfo[]"
    },
    "GET https://directory/ws": {
      "arguments": [
        "upgrade: websocket",
        "x-code-version header"
      ],
      "returns": "101 then {type:rooms,rooms:RoomInfo[]} after every change"
    }
  }
}
